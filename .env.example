# Sloppy Jenkins local settings.
# Copy this file to .env (gitignored) and fill in what you need. Every setting is optional.
# Never commit .env. Values here are read by the Jenkins container at start (see compose.yaml).
#
# Values are taken LITERALLY! Everything after the first "=" up to the end of the line is the value.
# Don't add quotes (they'll become part of the value!), and avoid trailing spaces.
# $, #, quotes and backslashes are fine inside a value, for example: JENKINS_ADMIN_PASSWORD=My$ecret#1
# Lines that start with # are comments.

# Administrator (used only on a FRESH jenkins_home, see init-scripts/10-security.groovy)
# Without JENKINS_ADMIN_PASSWORD a RanDoM password is written to
#   C:\MNT\docker\jenkins\jenkins_home\secrets\sloppy-initial-admin-password
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=

# Jenkins URL (Manage Jenkins -> System). Leave empty to keep what is configured there.
# Example when exposing through ngrok: https://YOUR-DOMAIN.ngrok-free.dev/
SLOPPY_JENKINS_URL=

# Windows inbound agent node (created only when missing, see init-scripts/30-windows-agent.groovy)
JENKINS_WINDOWS_AGENT_NAME=windows_build_agent
JENKINS_WINDOWS_AGENT_WORKDIR=C:\Jenkins
JENKINS_WINDOWS_AGENT_LABELS=windows-label
JENKINS_WINDOWS_AGENT_EXECUTORS=1

#  Username/password credentials (see init-scripts/20-username-credentials.groovy)
# One numbered set per credential. numbers may have gaps (1, 2, 10). A complete set (ID, USER, PASSWORD)
# creates a global "Username with password" credential on start, only if that ID does not exist yet.
# Existing credentials are never overwritten. change them in Manage Jenkins -> Credentials.
# DESCRIPTION is optional. IDs may use letters, digits, _ . and -
# USER, PASSWORD and DESCRIPTION are used exactly as written (including any spaces), so avoid trailing spaces.
# Tip: after the first start the credential is stored encrypted in Jenkins, so you can delete the
# PASSWORD line from .env (an existing credential needs nothing else). Values in .env are plain text on
# disk and visible through "docker inspect".
# Remove the leading "#" to use:
#SLOPPY_CRED_1_ID=gitlab-repo-token
#SLOPPY_CRED_1_USER=your-gitlab-user
#SLOPPY_CRED_1_PASSWORD=your-token-or-password
#SLOPPY_CRED_1_DESCRIPTION=GitLab repository token (read access)

#SLOPPY_CRED_2_ID=test_cred_for_testing
#SLOPPY_CRED_2_USER=MeOhMy
#SLOPPY_CRED_2_PASSWORD=Passw0rdIsV0dk4
#SLOPPY_CRED_2_DESCRIPTION=Some test credential for testing purposes

#  Optional SSH build node (see init-scripts/31-ssh-agent.groovy)
# Nothing happens unless SLOPPY_SSH_AGENT_HOST is set. Then a node is created once (never changed later).
# The machine needs an SSH server and Java 21+. The first connection waits until you trust its host key
# in Manage Jenkins -> Nodes. Empty values use the defaults shown.
# It logs in with the "Username with password" credential whose ID is SLOPPY_SSH_AGENT_CRED_ID; create it
# with a SLOPPY_CRED_<n> set above using that ID, or in Manage Jenkins -> Credentials.
# The default label windows-label is shared with the inbound node; use another label to keep jobs apart.
SLOPPY_SSH_AGENT_HOST=
# default 22
SLOPPY_SSH_AGENT_PORT=
# default windows_agent
SLOPPY_SSH_AGENT_NAME=
# default c:\jenkins (on the SSH machine)
SLOPPY_SSH_AGENT_ROOT=
# default 3
SLOPPY_SSH_AGENT_EXECUTORS=
# default windows-label
SLOPPY_SSH_AGENT_LABELS=
# default C:\jdk-latest\bin\java.exe
SLOPPY_SSH_AGENT_JAVA=
# default jenkins_agent_credentials
SLOPPY_SSH_AGENT_CRED_ID=
